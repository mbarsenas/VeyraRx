# VeyraRx local development defaults
VEYRA_DATA_PROVIDER=mock
VEYRA_AUTH_MODE=demo

# PostgreSQL / Neon mode
# Set VEYRA_DATA_PROVIDER=postgres and provide a private connection string in .env.local.
DATABASE_URL=
VEYRA_MEMBER_ID=member-demo-001

# Required when production authentication is enabled
AUTH_SECRET=
