{
  "name": "smarterx-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:security": "tsx --test test/auth-audit.test.ts test/auth-rate-limit.test.ts test/member-access.test.ts test/member-claims.test.ts test/member-production-data.test.ts test/security-headers.test.ts",
    "check:prod-data": "node -e \"const p=process.env.VEYRA_DATA_PROVIDER;if(process.env.NODE_ENV==='production'&&p!=='data-api'){console.error('Production requires VEYRA_DATA_PROVIDER=data-api');process.exit(1)}\""
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/neon-js": "^0.6.2-beta",
    "@neondatabase/serverless": "^1.0.2",
    "next": "16.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
